# This app has no authentication — every variable below is optional. See the
# README's "No built-in authentication" section before exposing it beyond
# your own LAN.

# ---------------------------------------------------------------------------
# AI (optional — everything else works without it)
# ---------------------------------------------------------------------------

# Enables photo scanning, nutrition-label parsing, and natural-language logging.
# Without it the app falls back to database search and manual entry.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Swap to claude-sonnet-5 or claude-haiku-4-5 to cut cost per scan.
ANTHROPIC_MODEL=claude-opus-5

# Long edge, in pixels, that photos are downscaled to before upload.
# Lower = cheaper and faster; higher = slightly better portion estimates.
PHOTO_MAX_EDGE=1568

# ---------------------------------------------------------------------------
# Voice (optional)
# ---------------------------------------------------------------------------

# Any OpenAI-compatible /v1/audio/transcriptions endpoint. Works with OpenAI,
# Groq, or a self-hosted whisper.cpp / faster-whisper container.
# Leave blank to use the browser's built-in speech recognition instead, which
# works in a Safari tab but is unreliable in an installed PWA.
STT_ENDPOINT=
STT_API_KEY=
STT_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Open Food Facts
# ---------------------------------------------------------------------------

# Open Food Facts asks every client to identify itself. Put your own contact
# address here — generic user agents get blocked.
OFF_CONTACT_EMAIL=you@example.com

